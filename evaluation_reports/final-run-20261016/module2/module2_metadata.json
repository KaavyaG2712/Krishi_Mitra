{
  "task": "district-level crop yield regression (not farm-level profit or a direct recommendation)",
  "dataset": "data\\raw\\crop-yield-benchmark\\crop_yield.csv",
  "features": [
    "state",
    "district",
    "year",
    "crop"
  ],
  "target": "yield, kg/ha",
  "split": {
    "type": "latest-years chronological holdout",
    "train_years": [
      1966,
      2012
