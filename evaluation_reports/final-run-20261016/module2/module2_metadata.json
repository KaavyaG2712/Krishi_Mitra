      "r2": -0.2074912111657694,
      "test_rows": 10011,
      "fit_seconds": 0.13,
      "predict_seconds": 0.01
    },
    {
      "model": "random_forest",
      "mae_kg_ha": 676.8885663299214,
      "rmse_kg_ha": 1071.5026804072659,
      "r2": 0.11593507402018077,
      "test_rows": 10011,
      "fit_seconds": 35.037,
      "predict_seconds": 0.061
    },
    {
      "model": "xgboost",
      "mae_kg_ha": 683.0988884141507,
      "rmse_kg_ha": 1080.9659943340644,
      "r2": 0.1002503195606761,
      "test_rows": 10011,
      "fit_seconds": 0.404,
      "predict_seconds": 0.02
    }
  ],
  "limitations": [
    "Predictive yield evaluation does not evaluate crop choice utility or profit.",
