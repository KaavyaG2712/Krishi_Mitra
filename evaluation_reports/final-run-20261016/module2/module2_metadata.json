      2013,
      2014,
      2015,
      2016,
      2017
    ],
    "train_rows": 89651,
    "test_rows": 10011,
    "districts_in_both": 304
  },
  "same_test_rows_for_all_models": true,
  "models": [
    {
      "model": "mean_baseline",
