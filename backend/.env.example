APP_NAME=KrishiMitra API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://krishimitra:krishimitra_local_only@127.0.0.1:5433/krishimitra
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HEALTH_CONFIDENCE_THRESHOLD=0.75
GEMINI_API_KEY=replace-with-your-local-secret
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional audio-capable model override; blank reuses GEMINI_GENERATION_MODEL.
GEMINI_SPEECH_MODEL=

# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable across workers/restarts; never expose this to the browser.
SIGNING_SECRET=

# Official SHC v1.35 GraphQL endpoint. Requires approved consumer registration.
SOIL_HEALTH_API_URL=https://soilhealth4.dac.gov.in/
SOIL_HEALTH_API_TOKEN=
SOIL_HEALTH_REFRESH_TOKEN=
SOIL_HEALTH_TIMEOUT_SECONDS=12
SOIL_HEALTH_CACHE_SECONDS=900
# Turn on ONLY after the authority permits public area-level, non-personal results.
SOIL_HEALTH_AREA_ACCESS=false
# Leave empty until the API issuer confirms result units. Never guess kg/ha/ppm.
# Maps official parameter keys to confirmed units, e.g. {"pH":"pH"}.
SOIL_HEALTH_UNITS_JSON={}
# Explicit synthetic /soil/demo endpoint, development only; never a lookup fallback.
SOIL_HEALTH_DEMO=false
