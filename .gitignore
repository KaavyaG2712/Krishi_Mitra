!/data/raw/crop-yield-benchmark/source_metadata.json
/data/processed/
/data/external_test/
/data/splits/*.csv
/data/splits/*.summary.json

# Keep only the released crop-health inference artifact
/models/checkpoints/*
!/models/checkpoints/mobilenetv2-10class-v1/
